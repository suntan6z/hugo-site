{
  "name": "loconsole-admin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync-brand": "node scripts/sync-brand.mjs",
    "predev": "node scripts/sync-brand.mjs",
    "dev": "vite dev --port 5180",
    "prebuild": "node scripts/sync-brand.mjs",
    "build": "vite build",
    "preview": "node build",
    "check": "node scripts/sync-brand.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "node --test 'test/**/*.test.ts'",
    "test:integration": "npm run build && node --test --test-concurrency=1 'test/**/*.integration.ts'"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "svelte": "^5.20.0",
    "svelte-check": "^4.7.7",
    "typescript": "^5.8.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "jose": "^6.0.10",
    "marked": "^18.1.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
