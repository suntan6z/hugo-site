# Local development needs none of this — with GH_APP_ID unset the portal runs in
# local mode: content is read/written in ../content, state in admin/.state.

# --- deployed mode ---------------------------------------------------------
# GH_APP_ID=123456
# GH_INSTALLATION_ID=12345678
# GH_PRIVATE_KEY_B64=<base64 of the GitHub App .pem>
# GH_OWNER=suntan6z
# GH_REPO=hugo-site
# GH_BRANCH=main

# ORIGIN=https://admin.loconsole.eu     # required: SvelteKit CSRF check
# RP_ID=admin.loconsole.eu              # immutable once passkeys are enrolled
# SESSION_SECRET=<32 random bytes, base64>
# BOOTSTRAP_TOKEN=<random hex, gates /enroll>

# --- object storage (deployed state) ---------------------------------------
# SCW_BUCKET=loconsole-admin-state
# SCW_REGION=fr-par
# SCW_ACCESS_KEY=
# SCW_SECRET_KEY=

# --- integrations ----------------------------------------------------------
# RESEND_API_KEY=
# Visitor numbers. Litlyx has no API keys when self-hosted: in the dashboard,
# open Shareable links, create one, and paste its id (the part after /shared/).
# Set the password too if you gave the link one.
# LITLYX_TOKEN=
# LITLYX_SHARE_PASSWORD=
# LITLYX_HOST=https://litlyx.loconsole.eu# Google Search Console, read as a service account (the "Google" half of the Search
# page, and "Is it on Google?" in the article editor). Create a service account in
# Google Cloud with the Search Console API enabled, download its JSON key, add its
# email as a user of the property in Search Console, then:
#   GSC_SERVICE_ACCOUNT_B64=$(base64 -i key.json | tr -d '\n')
#   GSC_SITE_URL=sc-domain:loconsole.eu     # the property exactly as Search Console names it
# or https://lorenzo.loconsole.eu/ for a URL-prefix property.
# GSC_SERVICE_ACCOUNT_B64=
# GSC_SITE_URL=
# PageSpeed Insights ("Check speed" in the article editor). Works without a key at
# a low quota; a key from Google Cloud (PageSpeed Insights API) lifts it.
# PAGESPEED_API_KEY=
# Where the daily health check emails when something new goes wrong (needs
# RESEND_API_KEY). Unset: the home screen is the only place it shows.
# ALERT_EMAIL=
# INDEXNOW_KEY=
# DeepL, for "Draft from English" in the French and Italian tabs. A free
# "DeepL API Free" key (ends in :fx) allows 500,000 characters a month.
# deepl.com -> Account -> API Keys.
# DEEPL_API_KEY=
# Lets the Scaleway cron trigger ask the portal to run what is due (set on both
# the container and the trigger by create-container.sh). Generate with:
#   openssl rand -hex 32
# CRON_TOKEN=

# --- local development only -------------------------------------------------
# Skips the passkey ceremony on `npm run dev`. Ignored unless the portal is in
# local mode (GH_APP_ID unset), so it cannot affect the deployed container.
# ALLOW_DEV_LOGIN=1
